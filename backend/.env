# ============================================================
# FinanceFlow Backend – Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit this file to version control.
# ============================================================

# Application
ENVIRONMENT=development
APP_NAME=FinanceFlow BI API
APP_VERSION=2.0.0

# Database
# SQLite (development):
DATABASE_URL=sqlite:///./database/finance.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://financeflow_user:strongpassword@localhost:5432/financeflow_db

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-please-change-in-production-use-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS – comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Default Admin User (created on first startup)
ADMIN_EMAIL=admin@financeflow.com
ADMIN_PASSWORD=admin123

# ETL Scheduling
# Cron expression: minute hour day month weekday
ETL_CRON_HOUR=2
ETL_CRON_MINUTE=0

# Default Budget (used when no budget is configured for a month)
DEFAULT_BUDGET=3000.0
